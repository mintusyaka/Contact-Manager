@model Contact

<form method="post">
	<div class="border p-3 mt-4 bg-gradient">
		<div class="row pb-2">
			<h3>
				Editing contact
			</h3>
			<hr />
		</div>

		<div>
			<div class="row m-2">
				<label asp-for="Operator" class=""></label>
				<input asp-for="Operator" type="text" class="form-control" />
				<span asp-validation-for="Operator" class="text-danger"></span>
			</div>

			<div class="row m-2">
				<label asp-for="Description" class=""></label>
				<input asp-for="Description" type="text" class="form-control" />
				<span asp-validation-for="Description" class="text-danger"></span>
			</div>

			<div class="row m-2">
				<label asp-for="Phone" class=""></label>
				<input asp-for="Phone" class="form-control" />
				<span asp-validation-for="Phone" class="text-danger"></span>
			</div>

			<div class="row mx-auto">
				<div class="col-6 mx-auto">
					<button type="submit" class="btn btn-primary m-1 mt-2 form-control">Edit</button>
				</div>
				<div class="col-6 mx-auto">
					<a asp-controller="Home" asp-action="Index" class="btn btn-secondary m-1 mt-2 form-control"><i class="bi bi-arrow-return-left"></i>Back to Contact List</a>
				</div>
			</div>

		</div>
</form>